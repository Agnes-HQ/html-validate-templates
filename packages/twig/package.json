{
  "name": "html-validate-twig",
  "version": "0.1.0",
  "description": "Lint the HTML in Twig and Nunjucks templates with html-validate.",
  "keywords": [
    "html-validate",
    "html-validate-plugin",
    "html",
    "lint",
    "linter",
    "accessibility",
    "templates",
    "twig",
    "symfony",
    "nunjucks",
    "eleventy"
  ],
  "homepage": "https://github.com/Agnes-HQ/html-validate-templates/tree/main/packages/twig#readme",
  "bugs": "https://github.com/Agnes-HQ/html-validate-templates/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Agnes-HQ/html-validate-templates.git",
    "directory": "packages/twig"
  },
  "license": "MIT",
  "author": "Agnes (https://agnes.dev)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepack": "cp ../../LICENSE LICENSE"
  },
  "peerDependencies": {
    "html-validate": "^11.0.0"
  },
  "devDependencies": {
    "@html-validate-templates/core": "0.0.0"
  },
  "engines": {
    "node": "^22.22.0 || >=24.8.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
